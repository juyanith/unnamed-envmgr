#!/usr/bin/env bash
# Envmgr command entry point. Must remain compatible with Bash 3.2.

set -euo pipefail

envmgr_resolve_root() {
  local path="${BASH_SOURCE[0]}"
  local dir=""

  # Follow symlinks such as ~/.local/bin/envmgr without GNU readlink -f.
  while [[ -L "$path" ]]; do
    dir="$(cd -P -- "$(dirname -- "$path")" && pwd)"
    path="$(readlink -- "$path")"
    [[ "$path" == /* ]] || path="$dir/$path"
  done
  dir="$(cd -P -- "$(dirname -- "$path")" && pwd)"
  printf '%s\n' "$(dirname -- "$dir")"
}

ENVMGR_ROOT="$(envmgr_resolve_root)"
export ENVMGR_ROOT

# shellcheck source=lib/envmgr/common.sh
source "$ENVMGR_ROOT/lib/envmgr/common.sh"
# shellcheck source=lib/envmgr/platform.sh
source "$ENVMGR_ROOT/lib/envmgr/platform.sh"
# shellcheck source=lib/envmgr/machine.sh
source "$ENVMGR_ROOT/lib/envmgr/machine.sh"
# shellcheck source=lib/envmgr/summary.sh
source "$ENVMGR_ROOT/lib/envmgr/summary.sh"
# shellcheck source=lib/envmgr/config.sh
source "$ENVMGR_ROOT/lib/envmgr/config.sh"
# shellcheck source=lib/envmgr/package.sh
source "$ENVMGR_ROOT/lib/envmgr/package.sh"
envmgr_load_providers
# shellcheck source=lib/envmgr/system.sh
source "$ENVMGR_ROOT/lib/envmgr/system.sh"
# shellcheck source=lib/envmgr/commands.sh
source "$ENVMGR_ROOT/lib/envmgr/commands.sh"
# shellcheck source=lib/envmgr/setup.sh
source "$ENVMGR_ROOT/lib/envmgr/setup.sh"
# shellcheck source=lib/envmgr/evaluate.sh
source "$ENVMGR_ROOT/lib/envmgr/evaluate.sh"
# shellcheck source=lib/envmgr/migrate.sh
source "$ENVMGR_ROOT/lib/envmgr/migrate.sh"
# shellcheck source=lib/envmgr/publish.sh
source "$ENVMGR_ROOT/lib/envmgr/publish.sh"

envmgr_usage() {
  cat <<'EOF'
usage: envmgr <command> [arguments]

Commands:
  adopt config [--exact] [--encrypt] <target...>
      Start managing files or directories in your home directory.
  adopt config --from <machine-id> <target...>
      Copy config from another machine; the targets must not exist here.
  adopt package <provider> <package...>
      Add installed packages to this machine's manifest.
  check [config|package [provider]|system] [--offline]
      Report drift from the data repository; exits 3 when there is drift.
  drop config [--delete] [--yes] [--dry-run] <target...>
      Stop managing targets; --delete also deletes the files.
  drop package [--delete] [--yes] [--dry-run] <provider> <package...>
      Remove packages from the manifest; --delete also uninstalls them.
  evaluate [config|package|system] [--offline]
      Start the configured agent with the current check report.
  evaluate --from <machine-id> [target...] [--offline]
      Start the agent to copy or merge config from another machine.
  init [--data <path>] <machine-id>
      Select an existing machine for this computer.
  init [--data <path>] --new <machine-id> [--from <machine-id>]
      Create a new machine, optionally copied from another one.
  list [config|package [provider]|system]
      List what this machine manages.
  migrate <url> [--no-history] [--yes] [--dry-run]
      Move the data repository to a new, empty remote.
  migrate --follow <url> [--yes] [--dry-run]
      Switch this machine's data checkout to the migrated remote.
  publish [-m <message>] [--no-push] [--yes] [--dry-run]
      Commit this machine's changes in the data repository and push them.
  restore [--yes] [--dry-run]
      Restore packages, then config, then system units.
  restore config [target...] [--yes] [--dry-run]
      Apply config files to the home directory.
  restore package [provider] [--yes] [--dry-run]
      Install missing packages and upgrade each provider.
  restore system [unit...] [--force] [--yes] [--dry-run]
      Apply system units that are out of sync, or all of them with --force.
  setup
      Install prerequisites, clone the data repository, and select a machine.

See DESIGN.md for the full command interface.
EOF
}

main() {
  local command="${1:-}"

  # Kept for re-execution after the git provider updates envmgr or its data.
  ENVMGR_ARGS=("$@")

  [[ $# -gt 0 ]] && shift
  case "$command" in
    setup) envmgr_cmd_setup "$@" ;;
    init) envmgr_cmd_init "$@" ;;
    check) envmgr_cmd_check "$@" ;;
    list) envmgr_cmd_list "$@" ;;
    restore) envmgr_cmd_restore "$@" ;;
    adopt) envmgr_cmd_adopt "$@" ;;
    drop) envmgr_cmd_drop "$@" ;;
    evaluate) envmgr_cmd_evaluate "$@" ;;
    migrate) envmgr_cmd_migrate "$@" ;;
    publish) envmgr_cmd_publish "$@" ;;
    -h|--help|help) envmgr_usage ;;
    "")
      envmgr_usage >&2
      return 2
      ;;
    *)
      envmgr_usage >&2
      return 2
      ;;
  esac
}

main "$@"; exit
